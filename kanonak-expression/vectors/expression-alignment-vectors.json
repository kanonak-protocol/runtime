    {
      "id": "align-rejects-a-trace-from-another-expression",
      "description": "A trace that does not fit the expression is an ERROR, never a best-effort pairing: here the trace of Add(1,2) is aligned against Subtract(1,2)",
      "expr": {
        "type": "kanonak.org/transformations/Add",
        "arithLeft": {
          "type": "kanonak.org/transformations/IntegerLiteral",
          "integerLiteral": 1
        },
        "arithRight": {
          "type": "kanonak.org/transformations/IntegerLiteral",
