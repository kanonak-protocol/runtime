<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Kanonak.Expression</AssemblyName>
    <RootNamespace>Kanonak.Expression</RootNamespace>
    <Nullable>disable</Nullable>
    <Description>Kanonak expression runtime (expressionRuntimeVersion 2). Conformant port of the kanonak.org/transformations + kanonak.org/math evaluator, verified against the shared parity vectors.</Description>
    <Version>0.3.3</Version>
    <Authors>Kanonak Maintainers</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://kanonak.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kanonak-protocol/runtime</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The 1.x compatibility gate (runtime#29): the release workflow passes
       -p:KanonakExpressionBaseline=<last release> and pack fails on any breaking change
       against that published package. A member-specific property, because a
       global PackageValidationBaselineVersion would reach referenced projects too. -->
  <PropertyGroup Condition="'$(KanonakExpressionBaseline)' != ''">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(KanonakExpressionBaseline)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
